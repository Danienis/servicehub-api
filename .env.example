# Copie para .env (cp .env.example .env) e preencha. NUNCA versione o .env.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=servicehub
DB_USER=servicehub
DB_PASS=troque-esta-senha

# Gere com: openssl rand -base64 48
JWT_SECRET=

# Administrador inicial (opcional): criado na primeira subida se o e-mail nao existir
ADMIN_EMAIL=admin@servicehub.com
ADMIN_PASSWORD=

CORS_ALLOWED_ORIGINS=http://localhost:3000
